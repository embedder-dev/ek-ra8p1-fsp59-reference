<?xml version="1.0" ?>
<raModuleDescription>
    <config id="config.driver.ioport" path="fsp_cfg/r_ioport_cfg.h" version="0">
        <property id="config.driver.ioport.checking" display="Parameter Checking" default="config.driver.ioport.checking.system" description="If selected code for parameter checking is included in the build.">
            <option id="config.driver.ioport.checking.system" display="Default (BSP)" value="(BSP_CFG_PARAM_CHECKING_ENABLE)" />
            <option id="config.driver.ioport.checking.enabled" display="Enabled" value="(1)" />
            <option id="config.driver.ioport.checking.disabled" display="Disabled" value="(0)" />
        </property>
        <content>
#ifdef __cplusplus
extern "C" {
#endif

#define IOPORT_CFG_PARAM_CHECKING_ENABLE ${config.driver.ioport.checking}

#ifdef __cplusplus
}
#endif
        </content>
    </config>
    <module config="config.driver.ioport" display="System|${module.driver.ioport.name} I/O Port (r_ioport)" id="module.driver.ioport_on_ioport" common="1" version="1" url="group___i_o_p_o_r_t.html">
        <constraint display="Only one IOPORT driver instance is allowed">
            "${interface.driver.ioport}" === "1"
        </constraint>
        <constraint display="ELC signal source selection requires an ELC Driver">
            (
                (!"${module.driver.ioport.elc_trigger_ioport1}".startsWith("_signal.")) &amp;&amp;
                (!"${module.driver.ioport.elc_trigger_ioport2}".startsWith("_signal.")) &amp;&amp;
                (!"${module.driver.ioport.elc_trigger_ioport3}".startsWith("_signal.")) &amp;&amp;
                (!"${module.driver.ioport.elc_trigger_ioport4}".startsWith("_signal."))
            ) || ("1" === "${interface.driver.elc}")
        </constraint>
        <constraint display="RA8P1 PLL1P above 800 MHz requires the supported group-A KFLCAC part (Datasheet table 2.49).">!testExists("${interface.mcu.ra8p1.clock_limits}") || testExists("${interface.mcu.r7ka8p1kflcac}") || (Number("${board.clock.peripheral.ra8p1.pll1p}") &lt;= 800000000)</constraint>
        <constraint display="RA8P1 PLL1P exceeds the range-2 supply limit (Datasheet table 2.49).">!testExists("${interface.mcu.ra8p1.clock_limits}") || ("${config.bsp.fsp.clock_voltage_range}" != "config.bsp.fsp.clock_voltage_range.2") || (Number("${board.clock.peripheral.ra8p1.pll1p}") &lt;= 600000000)</constraint>
        <constraint display="RA8P1 CPUCLK exceeds the range-2 supply limit (Datasheet table 2.49).">!testExists("${interface.mcu.ra8p1.clock_limits}") || ("${config.bsp.fsp.clock_voltage_range}" != "config.bsp.fsp.clock_voltage_range.2") || (Number("${board.clock.peripheral.ra8p1.cpuclk}") &lt;= 600000000)</constraint>
        <constraint display="RA8P1 CPUCLK1 exceeds the range-2 supply limit (Datasheet table 2.49).">!testExists("${interface.mcu.ra8p1.clock_limits}") || ("${config.bsp.fsp.clock_voltage_range}" != "config.bsp.fsp.clock_voltage_range.2") || (Number("${board.clock.peripheral.ra8p1.cpuclk1}") &lt;= 150000000)</constraint>
        <constraint display="RA8P1 NPUCLK exceeds the range-2 supply limit (Datasheet table 2.49).">!testExists("${interface.mcu.ra8p1.clock_limits}") || ("${config.bsp.fsp.clock_voltage_range}" != "config.bsp.fsp.clock_voltage_range.2") || (Number("${board.clock.peripheral.ra8p1.npuclk}") &lt;= 300000000)</constraint>
        <constraint display="RA8P1 ICLK exceeds the range-2 supply limit (Datasheet table 2.49).">!testExists("${interface.mcu.ra8p1.clock_limits}") || ("${config.bsp.fsp.clock_voltage_range}" != "config.bsp.fsp.clock_voltage_range.2") || (Number("${board.clock.peripheral.ra8p1.iclk}") &lt;= 150000000)</constraint>
        <constraint display="RA8P1 MRICLK exceeds the range-2 supply limit (Datasheet table 2.49).">!testExists("${interface.mcu.ra8p1.clock_limits}") || ("${config.bsp.fsp.clock_voltage_range}" != "config.bsp.fsp.clock_voltage_range.2") || (Number("${board.clock.peripheral.ra8p1.mriclk}") &lt;= 150000000)</constraint>
        <constraint display="RA8P1 FCLK exceeds the range-2 supply limit (Datasheet table 2.49).">!testExists("${interface.mcu.ra8p1.clock_limits}") || ("${config.bsp.fsp.clock_voltage_range}" != "config.bsp.fsp.clock_voltage_range.2") || (Number("${board.clock.peripheral.ra8p1.fclk}") &lt;= 75000000)</constraint>
        <constraint display="RA8P1 PCLKA exceeds the range-2 supply limit (Datasheet table 2.49).">!testExists("${interface.mcu.ra8p1.clock_limits}") || ("${config.bsp.fsp.clock_voltage_range}" != "config.bsp.fsp.clock_voltage_range.2") || (Number("${board.clock.peripheral.ra8p1.pclka}") &lt;= 75000000)</constraint>
        <constraint display="RA8P1 PCLKB exceeds the range-2 supply limit (Datasheet table 2.49).">!testExists("${interface.mcu.ra8p1.clock_limits}") || ("${config.bsp.fsp.clock_voltage_range}" != "config.bsp.fsp.clock_voltage_range.2") || (Number("${board.clock.peripheral.ra8p1.pclkb}") &lt;= 37500000)</constraint>
        <constraint display="RA8P1 PCLKD exceeds the range-2 supply limit (Datasheet table 2.49).">!testExists("${interface.mcu.ra8p1.clock_limits}") || ("${config.bsp.fsp.clock_voltage_range}" != "config.bsp.fsp.clock_voltage_range.2") || (Number("${board.clock.peripheral.ra8p1.pclkd}") &lt;= 150000000)</constraint>
        <constraint display="RA8P1 PCLKE exceeds the range-2 supply limit (Datasheet table 2.49).">!testExists("${interface.mcu.ra8p1.clock_limits}") || ("${config.bsp.fsp.clock_voltage_range}" != "config.bsp.fsp.clock_voltage_range.2") || (Number("${board.clock.peripheral.ra8p1.pclke}") &lt;= 150000000)</constraint>
        <constraint display="RA8P1 BCLK exceeds the range-2 supply limit (Datasheet table 2.49).">!testExists("${interface.mcu.ra8p1.clock_limits}") || ("${config.bsp.fsp.clock_voltage_range}" != "config.bsp.fsp.clock_voltage_range.2") || (Number("${board.clock.peripheral.ra8p1.bclk}") &lt;= 75000000)</constraint>
        <constraint display="RA8P1 BCLK exceeds the VCC below 2.7 V limit (Datasheet table 2.49).">!testExists("${interface.mcu.ra8p1.clock_limits}") || ("${config.bsp.fsp.clock_vcc_range}" != "config.bsp.fsp.clock_vcc_range.low") || (Number("${board.clock.peripheral.ra8p1.bclk}") &lt;= 60000000)</constraint>
        <constraint display="RA8P1 EBCLK exceeds the VCC below 2.7 V limit (Datasheet table 2.49).">!testExists("${interface.mcu.ra8p1.clock_limits}") || ("${config.bsp.fsp.clock_vcc_range}" != "config.bsp.fsp.clock_vcc_range.low") || (Number("${board.clock.peripheral.ra8p1.ebclk}") &lt;= 30000000)</constraint>
        <constraint display="RA8P1 FSBLCTRL0 nondefault provisioning is unsupported; retain defaults and use an externally qualified FSBL/OTP provisioning process. Chip A prohibits FSBL enable.">!testExists("${interface.mcu.ra8p1.clock_limits}") || (("${config.bsp.fsp.FSBLCTRL0.FSBLEN}" === "config.bsp.fsp.FSBLCTRL0.FSBLEN.disabled") &amp;&amp; ("${config.bsp.fsp.FSBLCTRL0.FSBLSKIPSW}" === "config.bsp.fsp.FSBLCTRL0.FSBLSKIPSW.disabled") &amp;&amp; ("${config.bsp.fsp.FSBLCTRL0.FSBLSKIPDS}" === "config.bsp.fsp.FSBLCTRL0.FSBLSKIPDS.disabled") &amp;&amp; ("${config.bsp.fsp.FSBLCTRL0.FSBLCLK}" === "config.bsp.fsp.FSBLCTRL0.FSBLCLK.250"))</constraint>
        <constraint display="RA8P1 FSBLCTRL1 nondefault provisioning is unsupported; retain defaults and use an externally qualified FSBL/OTP provisioning process. Chip A prohibits FSBL enable.">!testExists("${interface.mcu.ra8p1.clock_limits}") || (("${config.bsp.fsp.FSBLCTRL1.FSBLEXMD}" === "config.bsp.fsp.FSBLCTRL1.FSBLEXMD.secure_report"))</constraint>
        <constraint display="RA8P1 FSBLCTRL2 nondefault provisioning is unsupported; retain defaults and use an externally qualified FSBL/OTP provisioning process. Chip A prohibits FSBL enable.">!testExists("${interface.mcu.ra8p1.clock_limits}") || (("${config.bsp.fsp.FSBLCTRL2.PORTPN}" === "config.bsp.fsp.FSBLCTRL2.PORTPN.15") &amp;&amp; ("${config.bsp.fsp.FSBLCTRL2.PORTGN}" === "config.bsp.fsp.FSBLCTRL2.PORTGN.reserved"))</constraint>
        <constraint display="RA8P1 SACC0 provisioning is unsupported; retain the disabled 0xFFFFFFFF sentinel and use an externally qualified provisioning process.">!testExists("${interface.mcu.ra8p1.clock_limits}") || testInteger("${config.bsp.fsp.SACC0}") &amp;&amp; (Number("${config.bsp.fsp.SACC0}") === 4294967295)</constraint>
        <constraint display="RA8P1 SACC1 provisioning is unsupported; retain the disabled 0xFFFFFFFF sentinel and use an externally qualified provisioning process.">!testExists("${interface.mcu.ra8p1.clock_limits}") || testInteger("${config.bsp.fsp.SACC1}") &amp;&amp; (Number("${config.bsp.fsp.SACC1}") === 4294967295)</constraint>
        <constraint display="RA8P1 SAMR provisioning is unsupported; retain the disabled 0xFFFFFFFF sentinel and use an externally qualified provisioning process.">!testExists("${interface.mcu.ra8p1.clock_limits}") || testInteger("${config.bsp.fsp.SAMR}") &amp;&amp; (Number("${config.bsp.fsp.SAMR}") === 4294967295)</constraint>
        <constraint display="RA8P1 CPU1 Non-secure DMA channel mask must be an integer from 0 to 0xFF.">!testExists("${interface.mcu.ra8p1.clock_limits}") || testInteger("${config.bsp.fsp.tz.dmacchsar.cpu1}") &amp;&amp; (Number("${config.bsp.fsp.tz.dmacchsar.cpu1}") &gt;= 0) &amp;&amp; (Number("${config.bsp.fsp.tz.dmacchsar.cpu1}") &lt;= 255)</constraint>
        <requires id="module.driver.ioport_on_ioport.requires.port" interface="interface.mcu.port" visible="false" display="Requires Ioport Peripheral" />
        <provides interface="interface.driver.ioport" />
        <property default="g_ioport" display="Name" id="module.driver.ioport.name" description="Module name.">
            <constraint display="Name must be a valid C symbol">testSymbol("${module.driver.ioport.name}")</constraint>
            <signal event="event.ioport.event.1" />
            <signal event="event.ioport.event.2" />
            <signal event="event.ioport.event.3" />
            <signal event="event.ioport.event.4" />
        </property>
        <property default="" display="1st Port ELC Trigger Source" id="module.driver.ioport.elc_trigger_ioport1" description="ELC source that will trigger the 1st port">
            <select enum="enum.disabled" />
            <select enum="_signal" />
            <linkConstraint display="Requires an ELC peripheral function for the 1st IOPORT">
                "${_link}" === "link.ioport1"
            </linkConstraint>
        </property>
        <property default="" display="2nd Port ELC Trigger Source" id="module.driver.ioport.elc_trigger_ioport2" description="ELC source that will trigger the 2nd port">
            <select enum="enum.disabled" />
            <select enum="_signal" />
            <linkConstraint display="Requires an ELC peripheral function for the 2nd IOPORT">
                "${_link}" === "link.ioport2"
            </linkConstraint>
        </property>
        <property default="" display="3rd Port ELC Trigger Source" id="module.driver.ioport.elc_trigger_ioport3" description="ELC source that will trigger the 3rd port">
            <select enum="enum.disabled" />
            <select enum="_signal" />
            <linkConstraint display="Requires an ELC peripheral function for the 3rd IOPORT or ELC Peripheral function for the 3rd IOPORT is unsupported">
                "${_link}" === "link.ioport3"
            </linkConstraint>
        </property>
        <property default="" display="4th Port ELC Trigger Source" id="module.driver.ioport.elc_trigger_ioport4" description="ELC source that will trigger the 4th port">
            <select enum="enum.disabled" />
            <select enum="_signal" />
            <linkConstraint display="Requires an ELC peripheral function for the 4th IOPORT or ELC Peripheral function for the 4th IOPORT is unsupported">
                "${_link}" === "link.ioport4"
            </linkConstraint>
        </property>
        <property default="g_bsp_pin_cfg" display="Pin Configuration Name" id="module.driver.ioport.pincfg" description="Name for pin configuration structure">
            <constraint display="Name must be a valid C symbol">testSymbol("${module.driver.ioport.pincfg}")</constraint>
        </property>

        <!-- Suppress pin configurator warning about adding debug and trace modules in stacks tab (No module exists for these peripherals). -->
        <peripheral name="" component="debug0" />
        <peripheral name="" component="trace0" />

        <!-- Clock pins do not need a stack because they can be configured in the clocks tab. Added it to ioport because it is included in every project. -->
        <peripheral name="" component="cgc0" />

        <header>
#define IOPORT_CFG_NAME ${module.driver.ioport.pincfg}
#define IOPORT_CFG_OPEN R_IOPORT_Open
#define IOPORT_CFG_CTRL ${module.driver.ioport.name}_ctrl

/* IOPORT Instance */
extern const ioport_instance_t ${module.driver.ioport.name};

/* IOPORT control structure. */
extern ioport_instance_ctrl_t ${module.driver.ioport.name}_ctrl;
        </header>
        <includes>
#include &quot;r_ioport.h&quot;
#include &quot;bsp_pin_cfg.h&quot;
        </includes>
        <declarations>
ioport_instance_ctrl_t ${module.driver.ioport.name}_ctrl;
const ioport_instance_t ${module.driver.ioport.name} =
        {
            .p_api = &amp;g_ioport_on_ioport,
            .p_ctrl = &amp;${module.driver.ioport.name}_ctrl,
            .p_cfg = &amp;${module.driver.ioport.pincfg},
        };
        </declarations>
        <api configurable="true">
            <file>ra/fsp/inc/instances/r_ioport.h</file>
            <file>ra/fsp/inc/api/r_ioport_api.h</file>
        </api>
    </module>
</raModuleDescription>
