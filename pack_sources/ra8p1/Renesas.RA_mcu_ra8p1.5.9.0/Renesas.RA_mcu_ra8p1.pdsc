    <condition id="Only_CM33_and_CLANG">
      <require Dcore="Cortex-M33" />
      <require Tcompiler="CLANG" />
    </condition>
    <condition id="Only_CM85_and_IAR">
      <require Dcore="Cortex-M85" />
      <require Tcompiler="IAR" />
    </condition>
    <condition id="Only_CM33_and_IAR">
      <require Dcore="Cortex-M33" />
      <require Tcompiler="IAR" />
    </condition>
    <condition id="Only_CM85_and_ARMCC">
      <require Dcore="Cortex-M85" />
      <require Tcompiler="ARMCC" />
    </condition>
    <condition id="Only_CM33_and_ARMCC">
      <require Dcore="Cortex-M33" />
      <require Tcompiler="ARMCC" />
    </condition>
  </conditions>
