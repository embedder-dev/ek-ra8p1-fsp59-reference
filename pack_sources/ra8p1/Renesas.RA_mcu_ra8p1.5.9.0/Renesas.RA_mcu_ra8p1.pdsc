  <conditions>
    <condition id="Only_GCC">
      <require Tcompiler="GCC" />
    </condition>
    <condition id="Only_CM85_and_GCC">
      <require Dcore="Cortex-M85" />
      <require Tcompiler="GCC" />
    </condition>
    <condition id="Only_CM33_and_GCC">
      <require Dcore="Cortex-M33" />
      <require Tcompiler="GCC" />
